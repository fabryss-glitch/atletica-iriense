# Copia questo file in .env.local (in locale) oppure inserisci le stesse
# variabili su Vercel → Settings → Environment Variables.
# Finché sono vuote, il sito mostra i 632 articoli dal file data/articoli.json
# e l'area riservata resta disattivata.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo per lo script di import (npm run import-articoli). MAI su Vercel
# come variabile NEXT_PUBLIC_, mai nel codice, mai su GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
